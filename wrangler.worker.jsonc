{
  "name": "privacychecker",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRIVATE_WINDOW_TESTS",
        "class_name": "PrivateWindowTest"
      }
    ]
  },
  "migrations": [
    {
      "tag": "private-window-test-v1",
      "new_sqlite_classes": [
        "PrivateWindowTest"
      ]
    }
  ]
}
